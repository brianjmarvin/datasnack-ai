{
  "endpoints": {
    "health": {
      "description": "Health check endpoint",
      "method": "GET",
      "path": "/health"
    },
    "main": {
      "description": "Main AI agent endpoint",
      "method": "POST",
      "path": "/api/v1/chatHandler",
      "request_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "description": "The request payload for the chat handler endpoint",
        "properties": {
          "context": {
            "description": "Optional context to provide additional information for the research",
            "properties": {
              "previousConversations": {
                "items": {
                  "properties": {
                    "content": {
                      "type": "string"
                    },
                    "role": {
                      "enum": [
                        "user",
                        "assistant"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "role",
                    "content"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "userPreferences": {
                "properties": {
                  "detailLevel": {
                    "enum": [
                      "low",
                      "medium",
                      "high"
                    ],
                    "type": "string"
                  },
                  "responseLength": {
                    "enum": [
                      "short",
                      "medium",
                      "long"
                    ],
                    "type": "string"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          },
          "metadata": {
            "description": "Optional metadata for tracking or logging purposes",
            "properties": {
              "sessionId": {
                "type": "string"
              },
              "userId": {
                "type": "string"
              }
            },
            "type": "object"
          },
          "options": {
            "description": "Optional settings for customizing the research output",
            "properties": {
              "maxResults": {
                "maximum": 10,
                "minimum": 1,
                "type": "integer"
              },
              "sources": {
                "items": {
                  "enum": [
                    "academic",
                    "news",
                    "general"
                  ],
                  "type": "string"
                },
                "type": "array"
              }
            },
            "type": "object"
          },
          "prompt": {
            "description": "The user's input prompt for the AI agent to research",
            "examples": [
              "What are the latest developments in AI?",
              "Summarize the current state of climate change research."
            ],
            "type": "string"
          }
        },
        "required": [
          "prompt"
        ],
        "title": "Chat Handler Request Payload",
        "type": "object"
      },
      "response_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "description": "Response schema for the chat handler endpoint",
        "oneOf": [
          {
            "properties": {
              "error": {
                "type": "null"
              },
              "metadata": {
                "properties": {
                  "status": {
                    "const": "success"
                  }
                }
              },
              "results": {
                "type": "object"
              }
            }
          },
          {
            "properties": {
              "error": {
                "type": "object"
              },
              "metadata": {
                "properties": {
                  "status": {
                    "const": "error"
                  }
                }
              },
              "results": {
                "type": "null"
              }
            }
          }
        ],
        "properties": {
          "error": {
            "description": "Error details if status is error",
            "properties": {
              "code": {
                "description": "Error code",
                "type": "string"
              },
              "details": {
                "description": "Additional error details",
                "type": [
                  "string",
                  "null"
                ]
              },
              "message": {
                "description": "Error message",
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "type": [
              "object",
              "null"
            ]
          },
          "metadata": {
            "properties": {
              "processingTime": {
                "description": "Time taken to process the request in milliseconds",
                "example": 250,
                "type": "number"
              },
              "status": {
                "description": "Status of the response",
                "enum": [
                  "success",
                  "error"
                ],
                "type": "string"
              }
            },
            "required": [
              "processingTime",
              "status"
            ],
            "type": "object"
          },
          "results": {
            "description": "Results of the research",
            "properties": {
              "data": {
                "items": {
                  "properties": {
                    "content": {
                      "description": "Content of the data point",
                      "type": "string"
                    },
                    "source": {
                      "description": "Source of the data point",
                      "type": "string"
                    },
                    "title": {
                      "description": "Title of the data point",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "type": [
                  "array",
                  "null"
                ]
              },
              "relatedTopics": {
                "items": {
                  "description": "Related topics to the research query",
                  "type": "string"
                },
                "type": [
                  "array",
                  "null"
                ]
              },
              "text": {
                "description": "Text summary of the research results",
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "type": [
              "object",
              "null"
            ]
          }
        },
        "required": [
          "metadata",
          "results"
        ],
        "title": "Chat Handler Response Schema",
        "type": "object"
      }
    }
  },
  "service": {
    "base_url": "http://localhost:8080",
    "description": "The agent does research on the user's prompt and returns the results.",
    "name": "AI Agent Service",
    "version": "1.0.0"
  }
}